{
  "schemaVersion": 2,
  "name": "basic",
  "description": "The default cycle with every step written out as a plain prompt. No flow system is needed. Copy this folder to make an own flow.",
  "source": "own",
  "steps": [
    { "id": "classify",    "title": "Classification", "when": "always",    "prompt": "steps/classify.md" },
    { "id": "grill",       "title": "Discussion (grilling)", "when": "questions", "prompt": "steps/grill.md" },
    { "id": "plan",        "title": "Planning",       "when": "always",    "prompt": "steps/plan.md" },
    { "id": "execute",     "title": "Execution",      "when": "always",    "prompt": "steps/execute.md" },
    { "id": "code-review", "title": "Code review",    "when": "always",    "prompt": "steps/code-review.md" },
    { "id": "verify",      "title": "Verification",   "when": "always",    "prompt": "steps/verify.md" },
    { "id": "ui-check",    "title": "UI check",       "when": "always",    "prompt": "steps/ui-check.md" },
    { "id": "ship",        "title": "Shipping",       "when": "always",    "prompt": "steps/ship.md" }
  ]
}
