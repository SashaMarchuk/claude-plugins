#!/usr/bin/env bash
# Harness Orchestrator entry point: harness <verb> [args]
set -euo pipefail

# Resolve this script's real path, following symlinks one hop at a time.
ho_src=${BASH_SOURCE[0]}
while [ -L "$ho_src" ]; do
  ho_dir=$(cd -P "$(dirname "$ho_src")" && pwd)
  ho_src=$(readlink "$ho_src")
  case $ho_src in /*) ;; *) ho_src="$ho_dir/$ho_src" ;; esac
done
HO_ROOT=$(cd -P "$(dirname "$ho_src")/.." && pwd)
export HO_ROOT

# shellcheck source=../lib/common.sh
. "$HO_ROOT/lib/common.sh"
# shellcheck source=../lib/isolation.sh
. "$HO_ROOT/lib/isolation.sh"
# shellcheck source=../lib/tickets.sh
. "$HO_ROOT/lib/tickets.sh"
# shellcheck source=../lib/files.sh
. "$HO_ROOT/lib/files.sh"
# shellcheck source=../lib/config.sh
. "$HO_ROOT/lib/config.sh"
# shellcheck source=../lib/run.sh
. "$HO_ROOT/lib/run.sh"
# shellcheck source=../lib/term.sh
. "$HO_ROOT/lib/term.sh"
# shellcheck source=../lib/sessions.sh
. "$HO_ROOT/lib/sessions.sh"
# shellcheck source=../lib/liveness.sh
. "$HO_ROOT/lib/liveness.sh"
# shellcheck source=../lib/slots.sh
. "$HO_ROOT/lib/slots.sh"
# shellcheck source=../lib/flow.sh
. "$HO_ROOT/lib/flow.sh"
# shellcheck source=../lib/screen.sh
. "$HO_ROOT/lib/screen.sh"

ho_usage() {
  cat <<USAGE
usage: harness <verb> [args]

verbs:
  version    print the plugin version
  help       print this help
  selftest   check that no 0.6.0 variable or script can leak into this engine
  tickets    the ticket queue (run "harness tickets help")
  config     config get <jq-path> [default] | config get --int <jq-path> <default> | config check
  run        run new [--workers N]: create a stamped run in this project
  state      state <run-dir> <verb>: markers, run ledger, stop (state help for verbs)
  session    session <run-dir> launch|close|list|status|read: sessions and their liveness
  slot       slot <run-dir> acquire|release|list|limits|heavy-ops|heavy-add: engine-enforced limits
  flow       flow profiles: list | check <flow> | steps <flow> | render <flow> <role> ...
  screen     screen text: classify a capture, watch a session, pre-trust a folder, wait
USAGE
}

verb=${1:-}
[ $# -gt 0 ] && shift

case $verb in
  version)  printf 'harness %s\n' "$(ho_version)" ;;
  help|-h|--help) ho_usage ;;
  selftest) ho_isolation_check ;;
  tickets)  ho_tickets "$@" ;;
  config)   ho_config_main "$@" ;;
  run)      [ "${1-}" = new ] || { ho_usage >&2; exit 64; }; shift; ho_run_new "$@" ;;
  state)    ho_state_main "$@" ;;
  session)  ho_session_main "$@" ;;
  slot)     ho_slot_main "$@" ;;
  flow)     ho_flow_main "$@" ;;
  screen)   ho_screen_main "$@" ;;
  *)
    [ -n "$verb" ] && printf 'harness: unknown verb: %s\n' "$verb" >&2
    ho_usage >&2
    exit 64
    ;;
esac
