#!/usr/bin/env bash
# Fake osascript for the iTerm2 backend tests. It reads the AppleScript the backend sends
# (from -e or stdin) and acts out the few shapes that backend uses; any other script exits 2.
# See fake-term-lib.sh for the state it keeps.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/fake-term-lib.sh"
if [ "${1:-}" = -e ]; then script=$2; else script=$(cat); fi
case $script in *'application "iTerm2"'*) ;; *) exit 2 ;; esac
quoted_after() { # quoted_after <prefix>: the first "..." value that follows <prefix>
  printf '%s\n' "$script" | sed -n "s/.*$1\"\\([^\"]*\\)\".*/\\1/p" | head -n 1
}
case $script in
  *'count windows'*)
    ft_log "osascript probe"
    echo 0
    ;;
  *'create window with default profile command'*)
    winid=$(quoted_after '(id of x as string) is ')
    cmd=$(quoted_after 'command ')
    [ -n "$cmd" ] || exit 2
    if [ -n "$winid" ] && grep -qxF -- "$winid" "$ft_dir/windows" 2>/dev/null; then
      w=$winid
    else
      w="W$(ft_next)"
      printf '%s\n' "$w" >> "$ft_dir/windows"
    fi
    h="FAKE-ITERM-$(ft_next)"
    ft_log "osascript open $h"
    ft_start "$h" "$cmd"
    printf '%s %s\n' "$w" "$h"
    ;;
  *'(unique id of s) is "'*)
    h=$(quoted_after '(unique id of s) is ')
    if ! ft_known "$h"; then echo notfound; exit 0; fi
    f=$(ft_file "$h")
    case $script in
      *'write text (ASCII character 27) newline NO'*) ft_log "osascript key $h Escape"; printf '<ESC>' >> "$f.in" ;;
      *'write text "" newline YES'*) ft_log "osascript key $h Enter"; printf '\n' >> "$f.in" ;;
      *'write text "'*'" newline NO'*)
        text=$(quoted_after 'write text ')
        ft_log "osascript send-text $h $text"
        printf '%s' "$text" >> "$f.in"
        ;;
      *'return (contents of s)'*) ft_log "osascript capture $h"; cat "$f.out"; exit 0 ;;
      *'tell s to close'*) ft_log "osascript close $h"; : > "$f.closed" ;;
      *) exit 2 ;;
    esac
    echo ok
    ;;
  *) exit 2 ;;
esac
